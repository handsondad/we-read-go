.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2b2b2b;
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.rank {
  width: 56rpx;
  text-align: center;
  font-weight: 700;
  color: #888;
}
.rank-1 { color: #f5a623; }
.rank-2 { color: #9b9b9b; }
.rank-3 { color: #cd7f32; }
.name {
  flex: 1;
  margin-left: 16rpx;
  color: #2b2b2b;
  font-size: 30rpx;
}
.stat {
  font-size: 24rpx;
  color: #888;
}
.empty {
  text-align: center;
  color: #aaa;
  margin-top: 80rpx;
}
