.container {
  padding: 24rpx;
}
.segs {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 0;
}
.seg {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 16rpx;
}
.seg.on {
  color: #07c160;
  font-weight: 600;
}
.add {
  margin: 24rpx 0;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2b2b;
}
.author {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}
.note {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-top: 12rpx;
  line-height: 1.5;
}
.rating, .star {
  font-size: 28rpx;
  color: #ddd;
}
.star.on {
  color: #f5a623;
}
.star.big {
  font-size: 44rpx;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 80rpx;
}
.primary,
.ghost,
.danger {
  margin-top: 24rpx;
}
.primary.small,
.ghost.small,
.danger.small,
.add {
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  margin: 12rpx 0 0;
}
.danger {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
}
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}
.fld {
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.area {
  height: 140rpx;
}
.fld-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.lbl {
  font-size: 28rpx;
  color: #666;
  width: 80rpx;
}
.chip {
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
}
.chip.on {
  color: #fff;
  background: #07c160;
}
.sheet-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}
.sheet-actions .danger,
.sheet-actions .primary {
  margin-left: 20rpx;
}
