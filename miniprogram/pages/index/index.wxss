.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 0;
}
.streak {
  font-size: 48rpx;
  font-weight: 600;
  color: #2b2b2b;
}
.sub {
  color: #888;
  margin-top: 8rpx;
}
.primary,
.ghost {
  margin-top: 24rpx;
}
.row {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
}
.link {
  background: transparent;
  color: #07c160;
  font-size: 28rpx;
}
.history {
  margin-top: 48rpx;
}
.h-title {
  color: #888;
  font-size: 26rpx;
}
.days {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.day {
  font-size: 24rpx;
  color: #666;
  background: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 8rpx 0 0;
}
