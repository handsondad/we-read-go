.bar {
  display: flex;
  justify-content: flex-end;
}
.sync {
  background: #07c160;
  color: #fff;
}
.add {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
  gap: 12rpx;
}
.inp {
  flex: 1;
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}
.addbtn {
  background: #2b2b2b;
  color: #fff;
}
.book {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.cover {
  width: 100rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: #eee;
}
.info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
}
.title {
  font-size: 30rpx;
  color: #2b2b2b;
}
.author {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}
.prog {
  font-size: 24rpx;
  color: #07c160;
  margin-top: 6rpx;
}
.empty {
  text-align: center;
  color: #aaa;
  margin-top: 80rpx;
}
