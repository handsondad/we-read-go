/* Tab */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #888;
}
.tab.on {
  color: #07c160;
  font-weight: 600;
}

/* 榜单行 */
.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.rank {
  width: 56rpx;
  text-align: center;
  font-weight: 700;
  color: #888;
}
.rank-1 { color: #f5a623; }
.rank-2 { color: #9b9b9b; }
.rank-3 { color: #cd7f32; }
.name {
  flex: 1;
  margin-left: 16rpx;
  color: #2b2b2b;
  font-size: 30rpx;
}
.stat {
  font-size: 24rpx;
  color: #888;
}
.empty {
  text-align: center;
  color: #aaa;
  margin-top: 80rpx;
}

/* 心得帖 */
.composer {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.draft {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.book-input {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
.small {
  font-size: 28rpx;
  padding: 8rpx 0;
}
.post {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.post-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.post .name {
  margin-left: 0;
  font-weight: 600;
  font-size: 28rpx;
}
.time {
  font-size: 22rpx;
  color: #bbb;
}
.book {
  display: block;
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 8rpx;
}
.content {
  display: block;
  font-size: 28rpx;
  color: #2b2b2b;
  line-height: 1.6;
  word-break: break-all;
}
.post-foot {
  margin-top: 16rpx;
  text-align: right;
}
.like {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
}
.like.liked {
  color: #fff;
  background: #07c160;
}

/* 共读营 */
.camp {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.camp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.camp-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2b2b;
  margin-bottom: 6rpx;
}
.join-btn {
  width: 140rpx;
  margin: 0;
}
.joined-tag {
  font-size: 24rpx;
  color: #07c160;
}
.camp-detail {
  background: transparent;
}
.camp-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.back {
  font-size: 26rpx;
  color: #07c160;
}
.sub-title {
  font-size: 26rpx;
  color: #888;
  margin: 24rpx 0 12rpx;
}

/* 头像 */
.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eee;
  flex-shrink: 0;
}
.av.sm {
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
}
.post-head {
  align-items: center;
}
.post-head .name {
  flex: 1;
}
