.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.h {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2b2b;
}
.tip {
  display: block;
  color: #888;
  font-size: 24rpx;
  margin: 12rpx 0;
}
.tip.err {
  color: #e54d42;
}
.cookie {
  width: 100%;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}
.api-key {
  margin-top: 20rpx;
  padding: 18rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 25rpx;
}
.legacy-toggle {
  margin-top: 22rpx;
  color: #947149;
  font-size: 24rpx;
}
.legacy {
  margin-top: 14rpx;
}
.save {
  background: #07c160;
  color: #fff;
  margin-top: 16rpx;
}
.nick {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  margin: 12rpx 0;
}
.profile-row {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
}
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border-radius: 50%;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}
.avatar.placeholder {
  background: #e8e8e8;
  color: #999;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}
.pick {
  padding: 16rpx 0;
  color: #2b2b2b;
  font-size: 28rpx;
}
