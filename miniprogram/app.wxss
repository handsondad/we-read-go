page {
  background: #f5f5f5;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.container {
  padding: 32rpx;
}
.primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
.ghost {
  background: #fff;
  color: #2b2b2b;
  border-radius: 12rpx;
}
button[disabled] {
  opacity: 0.6;
}
